{
  "name": "vscode-browser-sketch",
  "displayName": "Browser Sketch",
  "description": "Screenshot the VS Code Integrated Browser, annotate it and copy it to the clipboard.",
  "version": "0.1.2",
  "publisher": "rawendil",
  "author": {
    "name": "Sebastian Soczka"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rawendil/vscode-browser-sketch.git"
  },
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1B4332",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.117.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "browserSketch.capture",
        "title": "Screenshot Browser",
        "category": "Browser Sketch",
        "icon": "$(device-camera)"
      }
    ],
    "keybindings": [
      {
        "command": "browserSketch.capture",
        "key": "ctrl+alt+s",
        "mac": "ctrl+alt+s"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/vscode": "^1.116.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "keywords": [
    "screenshot",
    "browser",
    "integrated browser",
    "annotate",
    "markup",
    "draw",
    "clipboard"
  ]
}
